{
  "name": "Movie",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "movie",
        "series"
      ],
      "default": "movie"
    },
    "poster": {
      "type": "string"
    },
    "backdrop": {
      "type": "string"
    },
    "trailer": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "hls_url": {
      "type": "string"
    },
    "external_url": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cast": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "director": {
      "type": "string"
    },
    "year": {
      "type": "integer"
    },
    "imdb": {
      "type": "number"
    },
    "duration": {
      "type": "integer"
    },
    "language": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "quality": {
      "type": "string",
      "enum": [
        "HD",
        "Full HD",
        "4K"
      ],
      "default": "HD"
    },
    "age_rating": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "popular": {
      "type": "boolean",
      "default": false
    },
    "published": {
      "type": "boolean",
      "default": true
    },
    "views": {
      "type": "integer",
      "default": 0
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}