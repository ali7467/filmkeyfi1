{
  "name": "Episode",
  "type": "object",
  "properties": {
    "series_id": {
      "type": "string"
    },
    "season": {
      "type": "integer",
      "default": 1
    },
    "episode": {
      "type": "integer",
      "default": 1
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "hls_url": {
      "type": "string"
    },
    "duration": {
      "type": "integer"
    }
  },
  "required": [
    "series_id",
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}